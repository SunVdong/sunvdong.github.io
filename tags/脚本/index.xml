      "><span class="line"><span class="cl"><span class="cp">#!/usr/bin/expect
</span></span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="nb">set</span> filename <span class="o">[</span>lindex <span class="nv">$argv</span> 0<span class="o">]</span>
</span></span><span class="line"><span class="cl"><span class="nb">set</span> dir_path <span class="o">[</span>lindex <span class="nv">$argv</span> 1<span class="o">]</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="nb">set</span> IP_NOS_1 <span class="s2">&#34;192.168.122.11&#34;</span>
</span></span><span class="line"><span class="cl"><span class="nb">set</span> IP_NOS_2 <span class="s2">&#34;192.168.122.12&#34;</span>
</span></span><span class="line"><span class="cl"><span class="nb">set</span> IP_NOS_3 <span class="s2">&#34;192.168.122.13&#34;</span>
</span></span><span class="line"><span class="cl"><span class="nb">set</span> IP_NOS_4 <span class="s2">&#34;192.168.122.14&#34;</span>
</span></span><span class="line"><span class="cl"><span class="nb">set</span> IP_NOS_5 <span class="s2">&#34;192.168.122.15&#34;</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="nb">set</span> username <span class="s2">&#34;root&#34;</span>
</span></span><span class="line"><span class="cl"><span class="nb">set</span> passwd <span class="s2">&#34;root&#34;</span>
</span></span><span class="line"><span class="cl"><span class="nb">set</span> timeout <span class="m">200</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="k">if</span> <span class="o">{</span> <span class="nv">$argc</span>!<span class="o">=</span><span class="m">2</span> <span class="o">}</span> <span class="o">{</span>
</span></span><span class="line"><span class="cl">        puts <span class="s2">&#34;WARNING ! srcipt needs two parameter !&#34;</span>
</span></span><span class="line"><span class="cl">        puts <span class="s2">&#34;          Usage: (parameter 1: filename) filename you want to transfer&#34;</span>
</span></span><span class="line"><span class="cl">        puts <span class="s2">&#34;          Usage: (parameter 2: path)     path you want to save to where.&#34;</span>
</span></span><span class="line"><span class="cl">        puts <span class="s2">&#34;this scripts will cp file into 5 kvm!&#34;</span>
</span></span><span class="line"><span class="cl">        <span class="nb">exit</span> <span class="m">0</span>
</span></span><span class="line"><span class="cl"><span class="o">}</span>
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl">
</span></span><span class="line"><span class="cl"><span class="k">for</span> <span class="o">{</span><span class="nb">set</span> i 1<span class="o">}</span> <span class="o">{</span><span class="nv">$i</span> &lt; 6<span class="o">}</span> <span class="o">{</span>incr i<span class="o">}</span> <span class="o">{</span>
</span></span><span class="line"><span class="cl">        switch <span class="nv">$i</span> <span class="o">{</span>
</span></span><span class="line"><span class="cl">        <span class="m">1</span> <span class="o">{</span><span class="nb">set</span> ip <span class="nv">$IP_NOS_1</span><span class="o">}</span>
</span></span><span class="line"><span class="cl">        <span class="m">3</span> <span class="o">{</span><span class="nb">set</span> ip <span class="nv">$IP_NOS_3</span><span class="o">}</span>
</span></span><span class="line"><span class="cl">        <span class="m">4</span> <span class="o">{</span><span class="nb">set</span> ip <span class="nv">$IP_NOS_4</span><span class="o">}</span>
</span></span><span class="line"><span class="cl">        <span class="m">5</span> <span class="o">{</span><span class="nb">set</span> ip <span class="nv">$IP_NOS_5</span><span class="o">}</span>
</span></span><span class="line"><span class="cl">        <span class="o">}</span>
</span></span><span class="line"><span class="cl">        puts <span class="s2">&#34;#---------------------copy file to kvm</span><span class="nv">$i</span><span class="s2">------------------#&#34;</span>
</span></span><span class="line"><span class="cl">        spawn scp ./<span class="nv">$filename</span> <span class="nv">$username</span>@<span class="nv">$ip</span>:<span class="nv">$dir_path</span>
</span></span><span class="line"><span class="cl">        expect <span class="o">{</span>
</span></span><span class="line"><span class="cl">              <span class="s2">&#34;(yes/no)?&#34;</span> <span class="o">{</span> send <span class="s2">&#34;yes&#34;</span><span class="p">;</span> exp_continue <span class="o">}</span>
</span></span><span class="line"><span class="cl">              <span class="s2">&#34;assword:&#34;</span> <span class="o">{</span> send <span class="s2">&#34;</span><span class="nv">$passwd</span><span class="s2">\r&#34;</span> <span class="o">}</span>
</span></span><span class="line"><span class="cl">                <span class="o">}</span>
</span></span><span class="line"><span class="cl">        expect <span class="s2">&#34;100%&#34;</span>
</span></span><span class="line"><span class="cl">        sleep <span class="m">1</span>
</span></span><span class="line"><span class="cl"><span class="o">}</span></span></span></code></pre>
